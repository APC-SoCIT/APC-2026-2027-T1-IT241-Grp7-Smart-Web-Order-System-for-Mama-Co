@startuml
skinparam defaultTextAlignment left
title Activity Diagram: UC-07 Manage Reports

|Admin|
start
:Log in and navigate to Sales Reports Page\nfrom Admin Panel Dashboard;

|System|
:Authenticate user's access rights\nto reporting features;
if (Access authorized?) then (Yes)
  |Admin|
  :Select the report type and date range/filters\n(e.g., sales by platform, best-selling designs, inventory usage);

  |System|
  :Compile and aggregate relevant order,\npayment, and inquiry data for selected criteria;
  if (Sufficient data exists for filters?) then (Yes)
    :Display analytics dashboard with visualized data\n(graphs, tables, summary figures);
    :Automatically flag and alert Admin\nwhen order volume exceeds normal threshold;

    |Admin|
    :Review generated statistics and charts\non the Sales Reports Page;
    if (Export or Print requested?) then (Yes)
      :Select "Export" or "Print";
    else (No)
      :Finish review without exporting;
    endif

    |System|
    :Compile data into a downloadable file\n(e.g., PDF, Excel) or send to printer;
    :Provide file for download or send to printer;
    stop
  else (No - Insufficient Data)
    :Display "No data available" message;
    detach
  endif
else (No - Access Denied)
  :Display permissions error and deny dashboard access;
  detach
endif

@enduml
