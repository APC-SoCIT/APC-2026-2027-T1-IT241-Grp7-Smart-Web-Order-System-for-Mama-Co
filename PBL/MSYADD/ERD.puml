@startuml ERD
entity "USERS" as users {
  * user_id : UUID <<PK>>
  --
  full_name : VARCHAR(100)
  email : VARCHAR(100)
  password_hash : VARCHAR(255)
  phone_number : VARCHAR(20)
  role : VARCHAR(20)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "ORDERS" as orders {
  * order_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  order_status : VARCHAR(30)
  order_type : VARCHAR(20)
  total_amount : DECIMAL(10,2)
  shipping_address : TEXT
  customer_contact_number : VARCHAR(20)
  delivery_notes : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "ORDER_ITEMS" as order_items {
  * order_item_id : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  * product_id : UUID <<FK>>
  design_id : UUID <<FK>>
  quantity : INT
  unit_price : DECIMAL(10,2)
}

entity "CAKE_CUSTOM_DESIGNS" as custom_designs {
  * design_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  prompt_text : TEXT
  generated_image_url : TEXT
  status : VARCHAR(30)
  estimated_price : DECIMAL(10,2)
  cake_size : VARCHAR(50)
  tier_count : INT
  flavor : VARCHAR(50)
  frosting : VARCHAR(50)
  created_at : TIMESTAMP
}

entity "PRODUCTS" as products {
  * product_id : UUID <<PK>>
  --
  name : VARCHAR(100)
  description : TEXT
  category : VARCHAR(50)
  base_price : DECIMAL(10,2)
  image_url : TEXT
  is_available : BOOLEAN
  updated_at : TIMESTAMP
}

entity "PRODUCT_INGREDIENTS" as product_ingredients {
  * product_id : UUID <<PK, FK>>
  * ingredient_id : UUID <<PK, FK>>
  --
  qty_required : DECIMAL(10,2)
}

entity "INVENTORY" as inventory {
  * ingredient_id : UUID <<PK>>
  --
  ingredient_name : VARCHAR(100)
  current_stock : DECIMAL(10,2)
  unit_of_measure : VARCHAR(20)
  reorder_level : DECIMAL(10,2)
  unit_cost : DECIMAL(10,2)
  updated_at : TIMESTAMP
}

entity "INVENTORY_LOG" as inventory_log {
  * log_id : UUID <<PK>>
  --
  * ingredient_id : UUID <<FK>>
  change_qty : DECIMAL(10,2)
  reason : VARCHAR(50)
  created_at : TIMESTAMP
}

entity "PAYMENTS" as payments {
  * payment_id : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  provider : VARCHAR(30)
  status : VARCHAR(20)
  transaction_id : VARCHAR(100)
  amount : DECIMAL(10,2)
  proof_of_payment_url : TEXT
  created_at : TIMESTAMP
}

users ||--o{ orders : "places"
users ||--o{ custom_designs : "creates"
orders ||--|{ order_items : "contains"
products ||--o{ order_items : "included in"
custom_designs ||--o| order_items : "attached to"
orders ||--o| payments : "paid via"

products ||--|{ product_ingredients : "requires"
inventory ||--|{ product_ingredients : "used by"
inventory ||--o{ inventory_log : "tracked by"

@enduml
