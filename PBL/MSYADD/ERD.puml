@startuml Mama_and_Co_ERD
!theme plain
top to bottom direction
skinparam linetype ortho
skinparam shadowing false
skinparam classFontSize 12
skinparam classFontName "Arial"

entity "USERS" as users {
  * **user_id** : UUID <<PK>>
  --
  * full_name : VARCHAR(100)
  * email : VARCHAR(100) <<UNIQUE>>
  * password_hash : VARCHAR(255)
  phone_number : VARCHAR(20)
  * role : VARCHAR(20)
  * is_active : BOOLEAN
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "CUSTOMERS" as customers {
  * **customer_id** : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  preferred_contact : VARCHAR(50)
  * created_at : TIMESTAMP
}

entity "STAFF_MEMBERS" as staff_members {
  * **staff_id** : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * employee_number : VARCHAR(50)
  * position_title : VARCHAR(100)
  * access_level : VARCHAR(30)
  * created_at : TIMESTAMP
}

entity "ADMINS" as admins {
  * **admin_id** : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * permission_level : VARCHAR(30)
  * created_at : TIMESTAMP
}

entity "ADDRESSES" as addresses {
  * **address_id** : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * street_address : VARCHAR(255)
  * city : VARCHAR(100)
  * state_province : VARCHAR(100)
  * postal_code : VARCHAR(20)
  * is_default : BOOLEAN
  * created_at : TIMESTAMP
}

entity "PRODUCT_CATEGORIES" as product_categories {
  * **category_id** : UUID <<PK>>
  --
  * name : VARCHAR(100)
  description : TEXT
}

entity "PRODUCTS" as products {
  * **product_id** : UUID <<PK>>
  --
  * category_id : UUID <<FK>>
  * sku : VARCHAR(50) <<UNIQUE>>
  * name : VARCHAR(100)
  description : TEXT
  * base_price : DECIMAL(10,2)
  image_url : TEXT
  * is_available : BOOLEAN
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "CAKE_CUSTOM_DESIGNS" as cake_custom_designs {
  * **design_id** : UUID <<PK>>
  --
  * customer_id : UUID <<FK>>
  reviewed_by_user_id : UUID <<FK>>
  * size : VARCHAR(20)
  * flavor : VARCHAR(50)
  * frosting : VARCHAR(50)
  layers : INT
  topper : VARCHAR(100)
  color_code : VARCHAR(20)
  prompt_text : TEXT
  generated_image_url : TEXT
  * design_status : VARCHAR(20)
  decline_reason : TEXT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "CUSTOM_DESIGN_INGREDIENTS" as custom_design_ingredients {
  * **design_id** : UUID <<PK, FK>>
  * **inventory_item_id** : UUID <<PK, FK>>
  --
  * required_qty : DECIMAL(10,2)
}

entity "ORDERS" as orders {
  * **order_id** : UUID <<PK>>
  --
  * customer_id : UUID <<FK>>
  delivery_address_id : UUID <<FK>>
  handled_by_staff_id : UUID <<FK>>
  * order_status : VARCHAR(30)
  * order_type : VARCHAR(20)
  * subtotal_amount : DECIMAL(10,2)
  * tax_amount : DECIMAL(10,2)
  discount_amount : DECIMAL(10,2)
  * total_amount : DECIMAL(10,2)
  delivery_date : TIMESTAMP
  customer_notes : TEXT
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "ORDER_ITEMS" as order_items {
  * **order_item_id** : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  product_id : UUID <<FK>>
  design_id : UUID <<FK>>
  * quantity : INT
  * unit_price : DECIMAL(10,2)
  special_instructions : TEXT
  * line_total : DECIMAL(10,2)
}

entity "PAYMENTS" as payments {
  * **payment_id** : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  * payment_type : VARCHAR(30)
  * provider : VARCHAR(30)
  payment_method : VARCHAR(30)
  * status : VARCHAR(20)
  * amount_paid : DECIMAL(10,2)
  * currency : VARCHAR(3)
  transaction_id : VARCHAR(100)
  error_message : TEXT
  * created_at : TIMESTAMP
}

entity "INQUIRIES" as inquiries {
  * **inquiry_id** : UUID <<PK>>
  --
  customer_id : UUID <<FK>>
  handled_by_staff_id : UUID <<FK>>
  name : VARCHAR(100)
  email : VARCHAR(100)
  phone_number : VARCHAR(20)
  * message : TEXT
  * status : VARCHAR(20)
  * created_at : TIMESTAMP
}

entity "INVENTORY_ITEMS" as inventory_items {
  * **inventory_item_id** : UUID <<PK>>
  --
  managed_by_admin_id : UUID <<FK>>
  * item_name : VARCHAR(100)
  supplier_name : VARCHAR(100)
  * current_stock : DECIMAL(10,2)
  * unit_of_measure : VARCHAR(20)
  * cost_per_unit : DECIMAL(10,2)
  reorder_level : DECIMAL(10,2)
  last_restocked_at : TIMESTAMP
}

entity "PRODUCT_INGREDIENTS" as product_ingredients {
  * **product_id** : UUID <<PK, FK>>
  * **inventory_item_id** : UUID <<PK, FK>>
  --
  * required_qty : DECIMAL(10,2)
}

' Relationships

users ||--o| customers : "profile"
users ||--o| staff_members : "profile"
users ||--o| admins : "profile"
users ||--o{ addresses : "has"

customers ||--o{ orders : "places"
customers ||--o{ cake_custom_designs : "creates"
customers ||--o{ inquiries : "sends"

staff_members ||--o{ inquiries : "handles"
staff_members ||--o{ orders : "prepares"

admins ||--o{ inventory_items : "controls stock"

users ||--o{ cake_custom_designs : "reviews (Staff/Admin)"

product_categories ||--o{ products : "contains"
products ||--o{ product_ingredients : "recipe"
inventory_items ||--o{ product_ingredients : "used in product"

cake_custom_designs ||--o{ custom_design_ingredients : "custom recipe"
inventory_items ||--o{ custom_design_ingredients : "used in custom cake"

products ||--o{ order_items : "included in"
cake_custom_designs ||--o{ order_items : "attached to"

orders ||--|{ order_items : "contains"
orders ||--o{ payments : "paid via"
addresses ||--o{ orders : "delivered to"

@enduml
