@startuml
skinparam linetype ortho
skinparam shadowing false

entity "USERS" as users {
    * user_id : UUID <<PK>>
    --
    * full_name : VARCHAR(100)
    * email : VARCHAR(100) <<UNIQUE>>
    * password_hash : VARCHAR(255)
      phone_number : VARCHAR(20)
      role : VARCHAR(20)
      is_active : BOOLEAN
      created_at : TIMESTAMP
      updated_at : TIMESTAMP
}

entity "ADDRESSES" as addresses {
    * address_id : UUID <<PK>>
    --
    * user_id : UUID <<FK>>
      street_address : VARCHAR(255)
      city : VARCHAR(100)
      state_province : VARCHAR(100)
      postal_code : VARCHAR(20)
      is_default : BOOLEAN
      created_at : TIMESTAMP
}

entity "ORDERS" as orders {
    * order_id : UUID <<PK>>
    --
    * customer_id : UUID <<FK>>
    * delivery_address_id : UUID <<FK>>
      handled_by_staff_id : UUID <<FK, nullable>>
      order_status : VARCHAR(30)
      order_type : VARCHAR(20)
      subtotal_amount : DECIMAL(10,2)
      tax_amount : DECIMAL(10,2)
      discount_amount : DECIMAL(10,2)
      total_amount : DECIMAL(10,2)
      delivery_date : TIMESTAMP
      customer_notes : TEXT
      created_at : TIMESTAMP
      updated_at : TIMESTAMP
}

entity "ORDER_ITEMS" as order_items {
    * order_item_id : UUID <<PK>>
    --
    * order_id : UUID <<FK>>
      product_id : UUID <<FK, nullable>>
      design_id : UUID <<FK, nullable>>
      quantity : INT
      line_total : DECIMAL(10,2)
}

entity "PAYMENTS" as payments {
    * payment_id : UUID <<PK>>
    --
    * order_id : UUID <<FK>>
      payment_type : VARCHAR(30)
      provider : VARCHAR(30)
      payment_method : VARCHAR(30)
      status : VARCHAR(20)
      amount_paid : DECIMAL(10,2)
      transaction_id : VARCHAR(100)
      error_message : TEXT
      created_at : TIMESTAMP
}

entity "INQUIRIES" as inquiries {
    * inquiry_id : UUID <<PK>>
    --
    * customer_id : UUID <<FK>>
      handled_by_staff_id : UUID <<FK, nullable>>
      name : VARCHAR(100)
      email : VARCHAR(100)
      phone_number : VARCHAR(20)
      message : TEXT
      status : VARCHAR(20)
      created_at : TIMESTAMP
}

entity "CHAT_BOT" as chat_bot {
    * message_id : UUID <<PK>>
    --
    * inquiry_id : UUID <<FK>>
    * sender_type : VARCHAR(20)
      is_ai : BOOLEAN
    * message_text : TEXT
    * created_at : TIMESTAMP
}

entity "CAKE_CUSTOM_DESIGNS" as cake_designs {
    * design_id : UUID <<PK>>
    --
    * customer_id : UUID <<FK>>
      reviewed_by_user_id : UUID <<FK, nullable>>
      size : VARCHAR(50)
      flavor : VARCHAR(50)
      frosting : VARCHAR(50)
      layers : INT
      topper : VARCHAR(100)
      color_code : VARCHAR(20)
      prompt_text : TEXT
      generated_image_url : TEXT
      design_status : VARCHAR(20)
      decline_reason : TEXT
      created_at : TIMESTAMP
      updated_at : TIMESTAMP
}

entity "PRODUCT_CATEGORIES" as categories {
    * category_id : UUID <<PK>>
    --
    * name : VARCHAR(100)
      description : TEXT
}

entity "PRODUCTS" as products {
    * product_id : UUID <<PK>>
    --
    * category_id : UUID <<FK>>
    * sku : VARCHAR(50) <<UNIQUE>>
    * name : VARCHAR(100)
      description : TEXT
      base_price : DECIMAL(10,2)
      image_url : TEXT
      is_available : BOOLEAN
      created_at : TIMESTAMP
      updated_at : TIMESTAMP
}

entity "STOCKS" as stocks {
    * stock_id : UUID <<PK>>
    --
    * managed_by_user_id : UUID <<FK>>
    * item_name : VARCHAR(100)
      current_stock : DECIMAL(10,2)
      reorder_level : DECIMAL(10,2)
      last_restocked_at : TIMESTAMP
}

entity "PRODUCT_INGREDIENTS" as product_ingredients {
    * product_id : UUID <<PK, FK>>
    * stock_id : UUID <<PK, FK>>
    --
    * required_qty : DECIMAL(10,2)
}

entity "CUSTOM_DESIGN_INGREDIENTS" as custom_ingredients {
    * design_id : UUID <<PK, FK>>
    * stock_id : UUID <<PK, FK>>
    --
    * required_qty : DECIMAL(10,2)
}

' Relationships
users ||--o{ addresses : "has"
users ||--o{ orders : "places"
users ||--o{ inquiries : "sends"
users ||--o{ cake_designs : "creates"

users ||--o{ orders : "prepares"
users ||--o{ inquiries : "handles"
users ||--o{ cake_designs : "reviews"
users ||--o{ stocks : "manages stocks"

orders ||--o{ order_items : "contains"
orders ||--|| payments : "paid via"
addresses ||--o{ orders : "delivered to"

inquiries ||--o{ chat_bot : "contains logs"

categories ||--o{ products : "contains"
products ||--o{ order_items : "included in"
cake_designs ||--o{ order_items : "attached to"

products ||--o{ product_ingredients : "recipe"
stocks ||--o{ product_ingredients : "used in product"

cake_designs ||--o{ custom_ingredients : "custom recipe"
stocks ||--o{ custom_ingredients : "used in custom cake"
@enduml
