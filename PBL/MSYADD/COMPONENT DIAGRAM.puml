@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component Diagram for Backend API (Nest.js) - Smart Web Ordering System

' External Containers
Container(website_app, "Website Application", "React / Next.js", "Customer front-end web portal for ordering, custom cake design, and inquiries.")
Container(staff_portal, "Staff Portal", "React / Next.js", "Staff portal for processing orders, updating product stock, and managing inquiries.")
Container(admin_portal, "Admin Portal", "React / Next.js", "Admin portal for user management, system config, and sales analytics.")

ContainerDb(postgres_db, "PostgreSQL Database", "Supabase", "Stores user accounts, orders, products, stock levels, and catalog data.")
System_Ext(openai_api, "OpenAI API", "External API providing DALL-E image generation and NLP engine.")

' Backend API Container Boundary
Container_Boundary(backend_api, "Backend API (Nest.js)") {

    ' Controllers
    Component(auth_controller, "Auth Controller", "Nest.js Controller", "Handles registration, login, and token validation endpoints.")
    Component(ai_cake_controller, "AI Cake Controller", "Nest.js Controller", "Receives prompt requests for generative cake designs.")
    Component(chatbot_controller, "Chatbot Controller", "Nest.js Controller", "Handles customer chat inquiries.")
    Component(orders_controller, "Orders Controller", "Nest.js Controller", "Manages checkout, order fulfillment, and order status updates.")
    Component(products_controller, "Products Controller", "Nest.js Controller", "Manages product details, pricing, catalog items, and stock quantities.")

    ' Services
    Component(auth_service, "Auth Service", "Nest.js Service", "Validates JWT tokens and user roles (Customer, Staff, Admin).")
    Component(orders_service, "Orders Service", "Nest.js Service", "Handles order status updates and deducts product stock upon purchase.")
    Component(ai_cake_service, "AI Cake Service", "Nest.js Service", "Formats prompts and calls OpenAI DALL-E API.")
    Component(chatbot_service, "Chatbot Service", "Nest.js Service", "Processes NLP context and response routing.")
    Component(products_service, "Products Service", "Nest.js Service", "Handles product catalog operations, price changes, and stock management.")

    ' Database Layer
    Component(db_access_layer, "Database Access Layer", "Prisma / Supabase Client", "Abstracts SQL queries to PostgreSQL database.")
}

' Frontend to controller relations
Rel(website_app, auth_controller, "POST /auth/login", "HTTPS / JSON")
Rel(website_app, ai_cake_controller, "POST /ai/generate-cake", "HTTPS / JSON")
Rel(website_app, chatbot_controller, "POST /chat", "HTTPS / JSON")
Rel(website_app, orders_controller, "POST /orders", "HTTPS / JSON")
Rel(website_app, products_controller, "GET /products", "HTTPS / JSON")

Rel(staff_portal, auth_controller, "POST /auth/login", "HTTPS / JSON")
Rel(staff_portal, orders_controller, "GET /orders, PATCH /orders/:id", "HTTPS / JSON")
Rel(staff_portal, products_controller, "GET / PATCH /products/:id/stock", "HTTPS / JSON")

Rel(admin_portal, auth_controller, "POST /auth/login", "HTTPS / JSON")
Rel(admin_portal, products_controller, "POST / PUT / DELETE /products", "HTTPS / JSON")

' Controller to service relations
Rel(auth_controller, auth_service, "Uses")
Rel(ai_cake_controller, ai_cake_service, "Uses")
Rel(chatbot_controller, chatbot_service, "Uses")
Rel(orders_controller, orders_service, "Uses")
Rel(products_controller, products_service, "Uses")

' Service interaction & database relations
Rel(auth_service, db_access_layer, "Reads / Writes User Data")
Rel(orders_service, db_access_layer, "Reads / Writes Order Data")
Rel(orders_service, products_service, "Triggers product stock deduction")
Rel(products_service, db_access_layer, "Reads / Writes Product & Stock Data")

' External integrations & database execution
Rel(ai_cake_service, openai_api, "Generates Image via DALL-E", "HTTPS")
Rel(chatbot_service, openai_api, "Queries NLP Engine", "HTTPS")
Rel(db_access_layer, postgres_db, "Executes SQL queries", "Prisma Client / TCP")

@enduml
