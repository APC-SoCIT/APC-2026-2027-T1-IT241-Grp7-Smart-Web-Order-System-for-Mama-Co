@startuml
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title Component Diagram for Backend API (Nest.js) - Smart Web Ordering System

' External Containers
Container(web_app, "Web Application", "React / Next.js", "Single web domain for Customer, Staff and Admin: Manage Account, Manage Inquiry (with Chatbot), Manage Products, Manage Stocks, Manage Order, Process Payment, Manage Cake Design, and Manage Reports.")

ContainerDb(postgres_db, "PostgreSQL Database", "Supabase", "Stores accounts, inquiries, products, stocks, orders, payments, cake designs, and report data.")
System_Ext(payment_gateway, "Payment Gateway", "External payment provider that authorizes and confirms online payments.")
System_Ext(ai_system, "AI System (OpenAI API)", "External API providing DALL-E image generation and NLP engine.")

' Backend API Container Boundary
Container_Boundary(backend_api, "Backend API (Nest.js)") {

    ' Controllers (named after the Use Case Diagram)
    Component(account_controller, "Account Controller", "Nest.js Controller", "Manage Account: registration, login, profile updates, and role-based access.")
    Component(inquiry_controller, "Inquiry Controller", "Nest.js Controller", "Manage Inquiry: submit, track, and reply to inquiries.")
    Component(chatbot_controller, "Chatbot Controller", "Nest.js Controller", "Handles customer chat and escalates unresolved chats to Manage Inquiry.")
    Component(products_controller, "Products Controller", "Nest.js Controller", "Manage Products: product details, pricing, and catalog items.")
    Component(stock_controller, "Stock Controller", "Nest.js Controller", "Manage Stocks: stock quantities and availability checks.")
    Component(cake_design_controller, "Cake Design Controller", "Nest.js Controller", "Manage Cake Design: prompt requests, design review, approve or deny.")
    Component(orders_controller, "Orders Controller", "Nest.js Controller", "Manage Order: checkout, order fulfillment, and order status updates.")
    Component(payment_controller, "Payment Controller", "Nest.js Controller", "Process Payment: handles payment for orders.")
    Component(reports_controller, "Reports Controller", "Nest.js Controller", "Manage Reports: sales and order analytics.")

    ' Services
    Component(account_service, "Account Service", "Nest.js Service", "Validates credentials, JWT tokens, and user roles (Customer, Staff, Admin).")
    Component(inquiry_service, "Inquiry Service", "Nest.js Service", "Records inquiries with reference number and status, and manages replies.")
    Component(chatbot_service, "Chatbot Service", "Nest.js Service", "Processes NLP context, response routing, and escalation.")
    Component(products_service, "Products Service", "Nest.js Service", "Handles catalog operations and price changes.")
    Component(stock_service, "Stock Service", "Nest.js Service", "Handles stock quantity updates and availability checks.")
    Component(cake_design_service, "Cake Design Service", "Nest.js Service", "Formats prompts, calls DALL-E, and stores design approval status.")
    Component(orders_service, "Orders Service", "Nest.js Service", "Handles order status updates and deducts product stock upon purchase.")
    Component(payment_service, "Payment Service", "Nest.js Service", "Records and verifies payments for orders.")
    Component(reports_service, "Reports Service", "Nest.js Service", "Aggregates order, payment, and stock data into reports.")

    ' Database Layer
    Component(db_access_layer, "Database Access Layer", "Prisma / Supabase Client", "Abstracts SQL queries to PostgreSQL database.")
}

' Frontend to controller relations
Rel(web_app, account_controller, "POST /auth/login, /auth/register", "HTTPS / JSON")
Rel(web_app, inquiry_controller, "POST / GET / PATCH /inquiries", "HTTPS / JSON")
Rel(web_app, chatbot_controller, "POST /chat", "HTTPS / JSON")
Rel(web_app, products_controller, "GET / POST / PUT / DELETE /products", "HTTPS / JSON")
Rel(web_app, stock_controller, "GET / PATCH /stocks/:productId", "HTTPS / JSON")
Rel(web_app, cake_design_controller, "POST /ai/generate-cake, PATCH /designs/:id", "HTTPS / JSON")
Rel(web_app, orders_controller, "POST /orders, GET / PATCH /orders/:id", "HTTPS / JSON")
Rel(web_app, payment_controller, "POST /payments", "HTTPS / JSON")
Rel(web_app, reports_controller, "GET /reports", "HTTPS / JSON")

' Controller to service relations
Rel(account_controller, account_service, "Uses")
Rel(inquiry_controller, inquiry_service, "Uses")
Rel(chatbot_controller, chatbot_service, "Uses")
Rel(products_controller, products_service, "Uses")
Rel(stock_controller, stock_service, "Uses")
Rel(cake_design_controller, cake_design_service, "Uses")
Rel(orders_controller, orders_service, "Uses")
Rel(payment_controller, payment_service, "Uses")
Rel(reports_controller, reports_service, "Uses")

' Service interaction & database relations
Rel(account_service, db_access_layer, "Reads / Writes User Data")
Rel(inquiry_service, db_access_layer, "Reads / Writes Inquiry Data")
Rel(chatbot_service, inquiry_service, "Escalates unresolved chats")
Rel(products_service, db_access_layer, "Reads / Writes Product Data")
Rel(stock_service, db_access_layer, "Reads / Writes Stock Data")
Rel(cake_design_service, db_access_layer, "Reads / Writes Design Data")
Rel(orders_service, db_access_layer, "Reads / Writes Order Data")
Rel(orders_service, stock_service, "Triggers product stock deduction")
Rel(orders_service, payment_service, "Includes payment processing")
Rel(payment_service, db_access_layer, "Reads / Writes Payment Data")
Rel(reports_service, db_access_layer, "Reads Order, Payment & Stock Data")

' External integrations & database execution
Rel(cake_design_service, ai_system, "Generates Image via DALL-E", "HTTPS")
Rel(chatbot_service, ai_system, "Queries NLP Engine", "HTTPS")
Rel(inquiry_service, ai_system, "Requests AI reply suggestions", "HTTPS")
Rel(payment_service, payment_gateway, "Sends payment request and receives confirmation", "HTTPS")
Rel(db_access_layer, postgres_db, "Executes SQL queries", "Prisma Client / TCP")

@enduml
