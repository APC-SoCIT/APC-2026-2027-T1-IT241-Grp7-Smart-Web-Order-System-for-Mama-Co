@startuml ContextDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(customer, "Customer", "Places orders, requests custom cake designs, and interacts with the AI chatbot.")
Person(admin, "Store Admin / Manager", "Manages inventory, views analytics, processes POS orders, and manages order production status.")

System(orderingSystem, "Smart Web Ordering System", "Centralized platform for ordering, custom cake generation, and store management.")

System_Ext(paymentGateway, "Payment Gateway", "Processes GCash, Maya, and card payments.")
System_Ext(openai, "OpenAI API", "Provides DALL-E image generation and NLP chatbot services.")

Rel(customer, orderingSystem, "Uses", "HTTPS")
Rel(admin, orderingSystem, "Manages and monitors", "HTTPS")

Rel(orderingSystem, paymentGateway, "Initiates payments", "HTTPS/REST")
Rel(orderingSystem, openai, "Generates designs and handles queries", "HTTPS/REST")

@enduml
