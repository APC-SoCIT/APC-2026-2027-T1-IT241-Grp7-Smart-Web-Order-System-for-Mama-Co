@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()
LAYOUT_WITH_LEGEND()

title Detailed System Context Diagram - Smart Web Ordering System

' Actors
Person(customer, "Customer", "Browses catalog, customizes cakes via AI, manages account, and places online orders.")
Person(staff, "Staff", "Processes orders, responds to complex inquiries, and updates product inventory.")
Person(admin, "Admin", "Manages user accounts, configures system settings, and reviews business analytics.")

' Primary Boundary
System(ordering_system, "Smart Web Ordering System", "Centralized platform managing user accounts, order processing, POS synchronization, and catalog management.")

' External Systems
System_Ext(ai_system, "AI System", "External NLP chatbot and Generative AI engine for cake design preview generation.")

' Customer
Rel(customer, ordering_system, "Sends registration and login credentials", "HTTPS")
Rel(ordering_system, customer, "Returns authentication status and user profile", "HTTPS")

Rel(customer, ordering_system, "Submits product inquiries and chatbot prompts", "HTTPS")
Rel(ordering_system, customer, "Displays product details and AI chatbot responses", "HTTPS")

Rel(customer, ordering_system, "Submits custom cake design preferences", "HTTPS")
Rel(ordering_system, customer, "Renders visual cake preview and pricing", "HTTPS")

Rel(customer, ordering_system, "Submits order details and payment info", "HTTPS")
Rel(ordering_system, customer, "Sends order confirmation and receipt", "HTTPS")

' Staff
Rel(staff, ordering_system, "Updates product inventory and catalog items", "HTTPS")
Rel(ordering_system, staff, "Provides pending order notifications and inquiry queue", "HTTPS")
Rel(staff, ordering_system, "Submits inquiry responses and updates order fulfillment status", "HTTPS")

' Admin
Rel(admin, ordering_system, "Manages user permissions, staff roles, and system settings", "HTTPS")
Rel(ordering_system, admin, "Generates sales analytics, revenue reports, and inventory logs", "HTTPS")

' AI System
Rel(ordering_system, ai_system, "Forwards customer prompt text for NLP processing", "REST API / HTTPS")
Rel(ai_system, ordering_system, "Returns structured chatbot response text", "REST API / HTTPS")

Rel(ordering_system, ai_system, "Sends cake design parameters (flavor, tier, theme)", "REST API / HTTPS")
Rel(ai_system, ordering_system, "Returns generated cake design visual rendering", "REST API / HTTPS")

@enduml
