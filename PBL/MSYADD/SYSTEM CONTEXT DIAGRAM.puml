@startuml C4_DataFlows 

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml 

 

' Title and Configuration 

title Data Flow Context Diagram: Smart Web Ordering System 

 

' External Entities / Users (Dark Blue Blocks) 

Person(Customer, "Customer") 

Person(StaffAdmin, "Staff / Admin") 

 

' Central System (Main Blue Box) 

System(System, "Smart Web Ordering System", "Centralized platform for ordering, custom cake generation, and store management.") 

 

' External System (Gray Box) 

System_Ext(AISystem, "AI System", "Generative AI cake design tool and NLP chatbot services.") 

 

' Data Flows: Customer <--> System 

Rel(Customer, System, "registration / account info", "HTTPS") 

Rel(Customer, System, "product inquiry / prompt", "HTTPS") 

Rel(Customer, System, "cake design preferences", "HTTPS") 

Rel(Customer, System, "order details", "HTTPS") 

 

Rel(System, Customer, "account status", "HTTPS") 

Rel(System, Customer, "inquiry response / confirmation", "HTTPS") 

Rel(System, Customer, "visual cake preview", "HTTPS") 

Rel(System, Customer, "order confirmation", "HTTPS") 

 

' Data Flows: Staff / Admin <--> System 

Rel(StaffAdmin, System, "product inventory updates", "HTTPS") 

Rel(StaffAdmin, System, "complex inquiry responses", "HTTPS") 

 

Rel(System, StaffAdmin, "pending inquiries", "HTTPS") 

Rel(System, StaffAdmin, "consolidated orders (FB, FoodPanda, Grab)", "HTTPS") 

Rel(System, StaffAdmin, "business analytics / reports", "HTTPS") 

 

' Data Flows: System <--> AI System 

Rel(System, AISystem, "customer query text (NLP)", "HTTPS/REST") 

Rel(AISystem, System, "automated chatbot response", "HTTPS/REST") 

Rel(System, AISystem, "design prompt parameters", "HTTPS/REST") 

Rel(AISystem, System, "generated cake design visual", "HTTPS/REST") 

 

@enduml
