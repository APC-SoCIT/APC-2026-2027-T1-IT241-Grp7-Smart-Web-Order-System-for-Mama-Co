@startuml ERD
entity "USERS" as users {
  * user_id : UUID <<PK>>
  --
  full_name : VARCHAR(100)
  email : VARCHAR(100)
  phone_number : VARCHAR(20)
  role : VARCHAR(20)
  created_at : TIMESTAMP
}

entity "ORDERS" as orders {
  * order_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  order_status : VARCHAR(30)
  order_type : VARCHAR(20)
  total_amount : DECIMAL(10,2)
  created_at : TIMESTAMP
}

entity "ORDER_ITEMS" as order_items {
  * order_item_id : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  * product_id : UUID <<FK>>
  design_id : UUID <<FK>>
  quantity : INT
  unit_price : DECIMAL(10,2)
}

entity "CAKE_CUSTOM_DESIGNS" as custom_designs {
  * design_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  prompt_text : TEXT
  generated_image_url : TEXT
  created_at : TIMESTAMP
}

entity "PRODUCTS" as products {
  * product_id : UUID <<PK>>
  --
  name : VARCHAR(100)
  category : VARCHAR(50)
  base_price : DECIMAL(10,2)
  is_available : BOOLEAN
}

entity "PRODUCT_INGREDIENTS" as product_ingredients {
  * product_id : UUID <<PK, FK>>
  * ingredient_id : UUID <<PK, FK>>
  --
  qty_required : DECIMAL(10,2)
}

entity "INVENTORY" as inventory {
  * ingredient_id : UUID <<PK>>
  --
  ingredient_name : VARCHAR(100)
  current_stock : DECIMAL(10,2)
  unit_of_measure : VARCHAR(20)
  reorder_level : DECIMAL(10,2)
}

entity "INVENTORY_LOG" as inventory_log {
  * log_id : UUID <<PK>>
  --
  * ingredient_id : UUID <<FK>>
  change_qty : DECIMAL(10,2)
  reason : VARCHAR(50)
  created_at : TIMESTAMP
}

entity "PAYMENTS" as payments {
  * payment_id : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  provider : VARCHAR(30)
  status : VARCHAR(20)
  transaction_id : VARCHAR(100)
}

users ||--o{ orders : "places"
users ||--o{ custom_designs : "creates"
orders ||--|{ order_items : "contains"
products ||--o{ order_items : "included in"
custom_designs ||--o| order_items : "attached to"
orders ||--o| payments : "paid via"

products ||--|{ product_ingredients : "requires"
inventory ||--|{ product_ingredients : "used by"
inventory ||--o{ inventory_log : "tracked by"

@endl

