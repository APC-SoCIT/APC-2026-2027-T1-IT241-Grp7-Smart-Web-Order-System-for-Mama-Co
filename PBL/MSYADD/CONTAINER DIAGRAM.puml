@startuml
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
SHOW_LEGEND()

title Container Diagram - Smart Web Ordering System

' Actors (Top Tier)
together {
    Person(customer, "Customer")
    Person(staff, "Staff")
    Person(admin, "Admin")
}

' System Boundary
System_Boundary(smart_ordering_system, "Smart Web Ordering System") {

    ' Front-End Container (single web domain for all roles)
    Container(web_app, "Web Application", "React / Next.js", "Web interface for browsing, custom cake designing, ordering, and chat. Also used for order production tracking, POS, daily stock management, system config, store settings, user accounts, and analytics.")

    ' Core Backend Container
    Container(backend_api, "Backend API", "Nest.js / Node.js", "Handles business logic, AI integrations, POS, product stock, and order processing.")

    ' Storage Containers
    together {
        ContainerDb(database, "Database", "PostgreSQL (Supabase)", "Stores users, products, orders, catalog items, and design metadata.")
        Container(object_storage, "Object Storage", "Supabase Storage", "Stores uploaded and AI-generated custom cake images.")
    }
}

' External Systems
together {
    System_Ext(payment_gateway, "Payment Gateway", "e.g., GCash, Maya")
    System_Ext(ai_system, "AI System (OpenAI API)", "DALL-E & Chatbot Engine")
}

' Actor to Frontend Interactions
Rel_Down(customer, web_app, "Uses and submits orders", "HTTPS")
Rel_Down(staff, web_app, "Manages orders and stock", "HTTPS")
Rel_Down(admin, web_app, "Configures settings and views reports", "HTTPS")

' Frontend to Backend Interactions
Rel_Down(web_app, backend_api, "Makes API calls (orders, design prompts, stock, order updates, users, system config)", "HTTPS / WebSocket")

' Backend to Storage Interactions
Rel_Down(backend_api, database, "Reads and writes data", "SQL / Prisma ORM")
Rel_Down(backend_api, object_storage, "Uploads and retrieves image files", "HTTPS")

' Backend to External Systems Interactions
Rel_Down(backend_api, payment_gateway, "Processes payment transactions", "HTTPS / REST API")
Rel_Down(backend_api, ai_system, "Generates cake prompts & chats", "HTTPS / REST API")

@enduml
