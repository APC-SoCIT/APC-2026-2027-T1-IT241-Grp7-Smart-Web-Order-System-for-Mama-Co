@startuml
skinparam Monochrome true
skinparam Shadowing false

|Customer|
start
:Select product(s) from catalog & add to cart;
if (Custom cake design attached?) then (Yes)
  :Attach saved cake design to cart item;
else (No)
  :Continue with standard selection;
endif

|AI System|
:Update cart contents & running total;
:Check availability of items & ingredients;

if (All items available?) then (Yes)
  |Customer|
  :Proceed to Checkout Page;
  :Enter delivery details & payment method;
  :Confirm order details and submit order;

  |AI System|
  :Create order record (Status: "Pending");
  :Perform payment processing;

  if (Payment successful?) then (Yes)
    :Forward order to Order History Page / POS portal;
    :Notify Staff & Admin of new order;

    |Staff|
    :Review new order in dashboard;
    if (Accept order?) then (Yes)
      :Update order status to "Confirmed";
      :Prepare order (Kitchen tasks);
      :Update order status (In Preparation / Ready);
      :Mark order as Handed Over / Delivered;
      
      |AI System|
      :Update customer order-tracking status;
      :Send tracking notifications to Customer;

      |Customer|
      :Receive order & view completed status;
      stop
    else (No)
      |AI System|
      :Update order status to "Rejected";
      :Notify Customer of rejection;
      :Release reserved stock;
      stop
    endif

  else (No)
    |AI System|
    :Notify Customer payment failed;
    |Customer|
    :Choose to retry or cancel order;
    stop
  endif

else (No)
  |AI System|
  :Flag unavailable item(s);
  :Suggest substitute options or cancellation;
  |Customer|
  :Choose substitute or cancel order;
  stop
endif


@enduml
