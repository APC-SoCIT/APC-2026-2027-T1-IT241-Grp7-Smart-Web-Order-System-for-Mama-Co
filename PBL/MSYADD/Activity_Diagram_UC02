@startuml
title Activity Diagram: UC-02 Manage Inquiry

|Customer|
start
:Select "Inquiries" / "Contact Us" on website\n(or AI Chatbot conversation escalates);
:Fill out inquiry form\n(name, contact details, email, message);
:Submit inquiry;

|System|
:Validate that all required fields are completed[cite: 1];

if (All required fields valid?) then (Yes)
  :Create new inquiry record with status "Open"\nand assign a reference number[cite: 1];
  :Display confirmation message with reference number[cite: 1];
  :Add inquiry to Staff/Admin dashboard queue[cite: 1];

  |Staff/Admin|
  :Open inquiry from dashboard and review details[cite: 1];

  |System|
  :Display inquiry details and related order/account history[cite: 1];

  |Staff/Admin|
  :Draft and send reply to customer[cite: 1];

  |System|
  :Deliver reply via email and\nupdate inquiry status to "Answered"[cite: 1];

  |Customer|
  :Read reply[cite: 1];

  if (Customer responds again or needs further help?) then (Yes)
    :Send follow-up response[cite: 1];
    
    |Staff/Admin|
    :Review follow-up and draft another reply[cite: 1];
    
    |System|
    :Update inquiry status to "Answered"[cite: 1];
    
    |Customer|
    :Read updated response[cite: 1];
  else (No)
    |System|
    if (No further response within set period or Staff/Admin closes it?) then (Yes)
      :Update inquiry status to "Closed"[cite: 1];
    else (No)
      :Keep inquiry active[cite: 1];
    endif
  endif

else (No)
  |System|
  :Highlight invalid/missing fields and\nprevent submission until corrected[cite: 1];
  
  |Customer|
  :Correct details and resubmit[cite: 1];
endif

|System|
stop
@enduml
