@startuml
title Cake Ordering System - Full Code/Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
set separator none
skinparam packageStyle rectangle
hide empty members

package "1. Manage Account" {
  class AccountController <<UC 1>> {
    + manageAccount()
  }
  class Account {
    - id: int
    - name: String
    - role: String
  }
}

package "2. Manage Inquiry" {
  class InquiryController <<UC 2>> {
    + manageInquiry()
  }
  class ChatbotController <<UC 2>> {
    + startChat()
    + sendMessage()
    + getAIReply()
    + escalateToInquiry()
  }
  class Inquiry {
    - id: int
    - message: String
  }
}

package "3. Manage Products" {
  class ProductController <<UC 3>> {
    + manageProducts()
  }
  class Product {
    - id: int
    - name: String
    - price: double
  }
}

package "3.1 Manage Stocks" {
  class StockController <<UC 3.1>> {
    + manageStocks()
  }
  class Stock {
    - id: int
    - quantity: int
  }
}

package "3.2 Manage Order" {
  class OrderController <<UC 3.2>> {
    + manageOrder()
  }
  class Order {
    - id: int
    - total_amount: double
  }
}

package "3.2.1 Process Payment" {
  class PaymentController <<UC 3.2.1>> {
    + processPayment()
  }
  class Payment {
    - id: int
    - status: String
  }
}

package "4. Manage Cake Design" {
  class DesignController <<UC 4>> {
    + manageCakeDesign()
    + generateDesign()
    + approveDesign()
    + denyDesign()
  }
  class CakeDesign {
    - id: int
    - design_details: String
  }
}

package "5. Manage Reports" {
  class ReportController <<UC 5>> {
    + manageReports()
  }
  class Report {
    - id: int
    - data: String
  }
}

class AISystem <<external>> {
  + getSuggestions(prompt: String): String
}

' ---- Controllers to entities ----
AccountController --> Account
InquiryController --> Inquiry
ProductController --> Product
StockController --> Stock
OrderController --> Order
PaymentController --> Payment
DesignController --> CakeDesign
ReportController --> Report
ChatbotController ..> Inquiry : escalates

' ---- Entity relationships ----
Account "1" --> "*" Inquiry : submits
Account "1" --> "*" Order : places
Order "1" --> "*" Product : contains
Order "1" --> "1" Payment
Product "1" --> "1" Stock : has
Product "1" --> "*" CakeDesign

' ---- Use Case relationships (include / extend) ----
StockController ..> ProductController : <<extend>>
StockController ..> OrderController : <<include>>
OrderController ..> ProductController : <<extend>>
OrderController ..> DesignController : <<extend>>
OrderController ..> PaymentController : <<include>>

' ---- AI System (Manage Inquiry and Manage Cake Design) ----
ChatbotController ..> AISystem : requests AI replies
DesignController ..> AISystem : requests design recommendations

@enduml
