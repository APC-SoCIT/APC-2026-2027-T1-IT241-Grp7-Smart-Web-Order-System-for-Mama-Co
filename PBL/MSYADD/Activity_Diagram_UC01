@startuml
title Activity Diagram: UC-01 Manage Account

|Customer|
start
:Choose "Create Account" or "Sign In"\non Home Page;

if (Choose action?) then (Create Account)
  :Enter required information\n(name, email, password);
  :Submit registration form;

  |System|
  :Display Registration Form;
  :Perform Validate Credentials\n(check format & uniqueness);

  if (Email unique & input valid?) then (Yes)
    :Create new account record with\ndefault "Customer" role;
    :Authenticate user & start session;
    :Redirect to Customer Home Page;
  else (No)
    if (Email already in use?) then (Yes)
      :Notify email is in use &\nsuggest logging in;
    else (No)
      :Highlight invalid/incomplete\nfields & request correction;
    endif
  endif

else (Sign In)
  |Customer|
  :Enter credentials\n(email/username & password);
  :Submit Sign In form;

  |System|
  :Display Sign In Form;
  :Perform Validate Credentials\n(compare against records);

  if (Credentials valid?) then (Yes)
    :Authenticate user & start session;
    if (User role?) then (Customer)
      :Redirect to Customer Home Page;
    else (Staff / Admin)
      |Staff/Admin|
      :Access assigned role permissions;
      
      |System|
      :Redirect to Admin Panel Dashboard;
    endif
  else (No)
    :Display error message &\noffer password reset option;
  endif
endif

|Customer|
' Post-authentication actions
if (Perform User Action?) then (Edit Profile)
  :Navigate to "My Profile" / "Account Settings";

  |System|
  :Retrieve & display current account\ndetails in editable form;

  |Customer|
  :Edit profile details\n(e.g., address, contact number);
  :Submit changes;

  |System|
  if (Updated details valid?) then (Yes)
    :Save updated information to database;
    :Display confirmation message;
  else (No)
    :Highlight affected fields &\nprompt for correction;
  endif

else (Log Out)
  |Customer|
  :Select Log Out;

  |System|
  :End user session;
  :Redirect to Home Page;
endif

|System|
' Session Timeout Check
if (Session timed out due to inactivity?) then (Yes)
  :Automatically log out user;
  :Redirect to Log In Page;
else (No)
  :Continue session;
endif

|Customer|
stop
@enduml
