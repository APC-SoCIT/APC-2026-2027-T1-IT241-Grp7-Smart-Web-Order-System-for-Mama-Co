@startuml
title Activity Diagram: UC-01 Manage Account

start

:Open Smart Web Ordering System;
:Choose Create Account or Sign In;

if (Create Account?) then (Yes)
  :Display Registration Form;
  :Enter name, email, and password;
  :Submit registration form;
  
  if (Input & Email valid?) then (Yes)
    :Create account with default role;
  else (No)
    :Display error & request correction;
    stop
  endif

else (No)
  :Display Sign In Form;
  :Enter credentials;
  :Submit Sign In form;
  
  if (Credentials valid?) then (Yes)
    :Authenticate user & start session;
  else (No)
    :Display error / offer password reset;
    stop
  endif
endif

' Check authorization and route by role
if (User authenticated?) then (Yes)
  if (User role?) then (Customer)
    :Redirect to Customer Home Page;
  else (Staff / Admin)
    :Apply assigned role permissions;
    :Redirect to Admin Panel Dashboard;
  endif
else (No)
  :Return to Account Form;
  stop
endif

' Main User Actions
if (User Action?) then (Edit Profile)
  :Retrieve current account details;
  :Edit account information;
  :Submit changes;
  
  if (Updated details valid?) then (Yes)
    :Save details & display confirmation;
  else (No)
    :Highlight errors & request correction;
  endif

else (Log Out)
  :End user session;
  :Redirect to Home Page;
endif

' Session Timeout Check
if (Session timed out?) then (Yes)
  :Automatically log out user;
  :Redirect to Sign In Page;
else (No)
  :Continue session;
endif

stop
@enduml
